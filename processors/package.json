{
  "name": "@commercetools/processors",
  "version": "0.1.1",
  "homepage": "https://github.com/commercetools/commerce-mcp",
  "description": "A collection of output processors for commercetools MCP server",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prebuild": "pnpm run clean",
    "dev:build": "tsup --env.NODE_ENV dev",
    "build": "tsup",
    "clean": "rm -rf dist",
    "lint": "eslint \"./**/*.ts*\"",
    "prettier": "prettier './**/*.{js,ts,md,html,css}' --write",
    "prettier-check": "prettier './**/*.{js,ts,md,html,css}' --check",
    "test": "jest",
    "validate": "pnpm run lint --fix && pnpm run prettier && pnpm run test"
  },
  "packageManager": "pnpm@9.11.0",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dotenv": "18.0.8",
    "qs": "6.16.1"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "commercetools",
    "field-filtering",
    "transformations",
    "redaction",
    "transform",
    "tools"
  ],
  "author": "commercetools GmbH <info@commercetools.com> (https://commercetools.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commercetools/commerce-mcp.git",
    "directory": "processors"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/qs": "^6.15.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  }
}
