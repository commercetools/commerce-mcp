{
  "name": "@commercetools/commerce-mcp",
  "version": "4.2.2",
  "type": "module",
  "mcpName": "io.github.commercetools/commerce-mcp",
  "homepage": "https://github.com/commercetools/commerce-mcp",
  "description": "A command line tool for setting up commercetools MCP server",
  "bin": "dist/cli.js",
  "files": [
    "dist/cli.js",
    "dist/index.js",
    "LICENSE",
    "README.md",
    "VERSION",
    "package.json"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prebuild": "pnpm --filter @commercetools/processors run build && pnpm --filter @commercetools/commerce-agent run build",
    "dev": "concurrently -n BUILD,SERVER -c magenta,cyan \"pnpm dev:build\" \"pnpm dev:run\"",
    "dev:build": "tsup --env.NODE_ENV dev",
    "dev:run": "nodemon --watch dist dist/cli.js",
    "build": "tsc && node --input-type=module -e \"import {chmodSync} from 'node:fs'; chmodSync('dist/cli.js', '755')\"",
    "clean": "rm -rf dist",
    "lint": "eslint \"./**/*.ts*\"",
    "prettier": "prettier './**/*.{js,ts,md,html,css}' --write",
    "prettier-check": "prettier './**/*.{js,ts,md,html,css}' --check",
    "test": "jest",
    "validate": "pnpm run lint --fix && pnpm run prettier && pnpm run test"
  },
  "packageManager": "pnpm@9.11.0",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@commercetools/commerce-agent": "workspace:*",
    "@commercetools/processors": "workspace:*",
    "@modelcontextprotocol/server": "^2.3.1",
    "colors": "^1.4.0",
    "dotenv": "^18.0.8",
    "mcp-remote": "^0.15.2"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "commercetools"
  ],
  "author": "commercetools GmbH <info@commercetools.com> (https://commercetools.com)",
  "repository": {
    "url": "https://github.com/commercetools/commerce-mcp"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "concurrently": "^10.0.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  }
}
