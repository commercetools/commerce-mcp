{
  "name": "@commercetools/commerce-agent",
  "version": "4.3.1",
  "homepage": "https://github.com/commercetools/commerce-mcp",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "tsup --env.NODE_ENV dev",
    "build": "tsup",
    "clean": "rm -rf langchain ai-sdk modelcontextprotocol openai mastra",
    "lint": "eslint \"./**/*.ts*\"",
    "prettier": "prettier './**/*.{js,ts,md,html,css}' --write",
    "prettier-check": "prettier './**/*.{js,ts,md,html,css}' --check",
    "validate": "pnpm run lint --fix && pnpm run prettier && pnpm run test",
    "test": "jest",
    "test:watch": "jest --watch --collectCoverage=false"
  },
  "exports": {
    "./ai-sdk": {
      "types": "./ai-sdk/index.d.ts",
      "require": "./ai-sdk/index.js",
      "import": "./ai-sdk/index.mjs"
    },
    "./openai": {
      "types": "./openai/index.d.ts",
      "require": "./openai/index.js",
      "import": "./openai/index.mjs"
    },
    "./modelcontextprotocol": {
      "types": "./modelcontextprotocol/index.d.ts",
      "require": "./modelcontextprotocol/index.js",
      "import": "./modelcontextprotocol/index.mjs"
    },
    "./langchain": {
      "types": "./langchain/index.d.ts",
      "require": "./langchain/index.js",
      "import": "./langchain/index.mjs"
    },
    "./mastra": {
      "types": "./mastra/index.d.ts",
      "require": "./mastra/index.js",
      "import": "./mastra/index.mjs"
    }
  },
  "packageManager": "pnpm@9.11.0",
  "engines": {
    "node": ">=20"
  },
  "author": "commercetools GmbH <info@commercetools.com> (https://commercetools.com)",
  "repository": {
    "url": "https://github.com/commercetools/commerce-mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/qs": "^6.15.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@commercetools/checkout-sdk": "^2.1.0",
    "@commercetools/platform-sdk": "^9.7.0",
    "@commercetools/tools-core": "^0.6.2",
    "@commercetools/ts-client": "^5.1.1",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "express": "^5.3.0",
    "pluralize": "^8.0.0",
    "qs": "^6.16.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "peerDependencies": {
    "@langchain/core": "^0.3.6",
    "@mastra/core": "^0.8.0",
    "ai": "^4.1.54",
    "openai": "^4.86.1"
  },
  "workspaces": [
    "."
  ],
  "files": [
    "ai-sdk/**/*",
    "langchain/**/*",
    "modelcontextprotocol/**/*",
    "mastra/**/*",
    "LICENSE",
    "README.md",
    "VERSION",
    "package.json"
  ]
}
